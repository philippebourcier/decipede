# Project defaults, baked into the firmware at build time (tracked in git).
# A network forking this firmware edits this file; a single deployment puts
# its own values in provision/device.env instead (git-ignored, same keys,
# overrides these). See device.env.example, and centipede.env for an example
# network's branding.
#
# The config.json URL (CONFIG_URL) is the only URL built into the firmware:
# telemetry, firmware updates and the NTRIP caster all come from config.json.

BRAND_NAME=Decipede
BRAND_TAGLINE=MCU Base Status
BRAND_LOGO=web/logo.svg
