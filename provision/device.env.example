# Copy to device.env (git-ignored). Same keys as defaults.env, which these
# override. Baked into the firmware at build time.

# The config server: the only URL built into the firmware. The device fetches
# it at boot and with every update check, appending ?b=<hardware id>.
# Everything else comes from that config.json: ntrip_server, ntrip_port,
# telemetry_url, firmware_url, maint_window, ...
CONFIG_URL=https://your-server/config.json

# Status dashboard branding: name, subtitle, and an SVG logo (path relative
# to the repository root; keep it small, it is embedded in the firmware).
#BRAND_NAME=My RTK Network
#BRAND_TAGLINE=MCU Base Status
#BRAND_LOGO=provision/my-logo.svg
# provision/centipede.env has a complete example (Centipede-RTK).
