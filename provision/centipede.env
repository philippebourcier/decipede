# Example network profile: the Centipede-RTK branding. Copy these lines into
# provision/device.env (which also holds your CONFIG_URL) to build a
# Centipede-RTK station. Same keys as defaults.env, which they override.

BRAND_NAME=Centipede-RTK
BRAND_TAGLINE=MCU Base Status
BRAND_LOGO=provision/centipede.svg
